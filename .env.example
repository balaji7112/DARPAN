# ── Frontend (Vite, exposed to the browser; never put secrets here) ──────────
# URL of the optional ML service (ml-service/, e.g. deployed on Render).
# Leave empty to use the built-in client-side forecasting/anomaly models.
VITE_ML_API_URL=

# Copilot LLM proxy endpoint. On Vercel use /api/copilot (api/copilot.js).
# Leave empty to use the rule-based copilot only.
VITE_COPILOT_API_URL=

# ── Server-side only (Vercel project env vars, NOT prefixed with VITE_) ──────
# Enables the LLM copilot proxy in api/copilot.js.
ANTHROPIC_API_KEY=
# Optional model override (default: claude-opus-5-5).
ANTHROPIC_MODEL=

# ── ml-service (Render / Docker) ─────────────────────────────────────────────
# Comma-separated origins allowed to call the ML API (default "*").
ALLOWED_ORIGINS=https://your-app.vercel.app,http://localhost:5173
